From 0c9a8c8a08838fc8b75f1b9c083f13d92e95163c Mon Sep 17 00:00:00 2001
From: Mykyta Shupyliuk <15443199+Kaderimon@users.noreply.github.com>
Date: Tue, 20 Oct 2026 23:22:34 +0000
Subject: [PATCH 9/9] TUF-AX3000_V2 boot: ship stock 388_24049
 ATF/U-Boot/U-Boot DTB in bootfs; build NAND layout only

---
 .../bootloaders/Makefile                      |   7 +++++++
 .../stock_boot/TUF-AX3000_V2/README           |   5 +++++
 .../stock_boot/TUF-AX3000_V2/armtf.bin        | Bin 0 -> 24872 bytes
 .../stock_boot/TUF-AX3000_V2/dt.dtb           | Bin 0 -> 4707 bytes
 .../stock_boot/TUF-AX3000_V2/u-boot-nodtb.bin | Bin 0 -> 2644696 bytes
 .../src-rt-5.04axhnd.675x/build/make.uboot    |   5 +++++
 6 files changed, 17 insertions(+)
 create mode 100644 release/src-rt-5.04axhnd.675x/bootloaders/stock_boot/TUF-AX3000_V2/README
 create mode 100644 release/src-rt-5.04axhnd.675x/bootloaders/stock_boot/TUF-AX3000_V2/armtf.bin
 create mode 100644 release/src-rt-5.04axhnd.675x/bootloaders/stock_boot/TUF-AX3000_V2/dt.dtb
 create mode 100644 release/src-rt-5.04axhnd.675x/bootloaders/stock_boot/TUF-AX3000_V2/u-boot-nodtb.bin

diff --git a/release/src-rt-5.04axhnd.675x/bootloaders/Makefile b/release/src-rt-5.04axhnd.675x/bootloaders/Makefile
index eef4fc37a..4f0ecb238 100644
--- a/release/src-rt-5.04axhnd.675x/bootloaders/Makefile
+++ b/release/src-rt-5.04axhnd.675x/bootloaders/Makefile
@@ -707,6 +707,13 @@ endif
 ifneq ($(strip $(bcm_uboot_pmcfw_code_addr)$(bcm_uboot_pmcfw_data_addr)),)
 	cp -f $(UB)/arch/arm/mach-bcmbca/pmc/pmc_firmware_$(BRCM_CHIP)* $(objdir)/binaries
 endif
+	# Use the board's stock ATF/U-Boot when provided (stock_boot/<model>/README).
+	if [ -f stock_boot/$(BUILD_NAME)/u-boot-nodtb.bin ]; then \
+		echo "using stock boot loader from stock_boot/$(BUILD_NAME)"; \
+		cp -f stock_boot/$(BUILD_NAME)/armtf.bin $(atfobjdir)/armtf.bin; \
+		cp -f stock_boot/$(BUILD_NAME)/u-boot-nodtb.bin $(ubootobjdir)/u-boot-nodtb.bin; \
+		cp -f stock_boot/$(BUILD_NAME)/dt.dtb $(ubootobjdir)/dts/dt.dtb; \
+	fi
 	./build/work/generate_linux_its --dir=obj/binaries/linux/ --chip=$(BRCM_CHIP) \
 		${rootfs_hash_opt} ${gen_keyring_opt} \
 		$(if $(bcm_uboot_rootfs_encrypt),--mapper=obj/binaries/dm.txt) \
diff --git a/release/src-rt-5.04axhnd.675x/bootloaders/stock_boot/TUF-AX3000_V2/README b/release/src-rt-5.04axhnd.675x/bootloaders/stock_boot/TUF-AX3000_V2/README
new file mode 100644
index 000000000..60161bb2c
--- /dev/null
+++ b/release/src-rt-5.04axhnd.675x/bootloaders/stock_boot/TUF-AX3000_V2/README
@@ -0,0 +1,5 @@
+ATF, U-Boot and U-Boot DTB taken unchanged from the stock ASUS firmware
+TUF-AX3000_V2_3.0.0.4_388_24049 (same Broadcom BSP 5.04L.02p1), so the
+custom image boots with the loader the board already runs.
+bootloaders/Makefile (image_linux_fit) copies them over the freshly built
+ones before the Linux FIT is assembled.
diff --git a/release/src-rt-5.04axhnd.675x/bootloaders/stock_boot/TUF-AX3000_V2/armtf.bin b/release/src-rt-5.04axhnd.675x/bootloaders/stock_boot/TUF-AX3000_V2/armtf.bin
new file mode 100644
