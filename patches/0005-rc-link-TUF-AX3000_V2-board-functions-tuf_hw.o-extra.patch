From e74f4a9b944680f83e5a33ee5cb0d4a9098352d0 Mon Sep 17 00:00:00 2001
From: Mykyta Shupyliuk <15443199+Kaderimon@users.noreply.github.com>
Date: Tue, 20 Oct 2026 22:35:11 +0000
Subject: [PATCH 5/7] rc: link TUF-AX3000_V2 board functions (tuf_hw.o,
 extracted from TUF 388 GPL blobs by tufhw/extract.sh)

---
 release/src/router/rc/Makefile          |  11 +++++++++++
 release/src/router/rc/prebuild/tuf_hw.o | Bin 0 -> 40016 bytes
 2 files changed, 11 insertions(+)
 create mode 100644 release/src/router/rc/prebuild/tuf_hw.o

diff --git a/release/src/router/rc/Makefile b/release/src/router/rc/Makefile
index 9118fb289..50c9ba4ad 100644
--- a/release/src/router/rc/Makefile
+++ b/release/src/router/rc/Makefile
@@ -857,6 +857,12 @@ ifeq ($(or $(RTCONFIG_LACP),$(RTCONFIG_BONDING)),y)
 OBJS += $(if $(CONFIG_BCMWL5),agg_brcm.o)
 endif
 
+# TUF-AX3000_V2 board functions (BCM53134 LEDs, BCM84880 PHY) extracted from
+# the TUF 388 GPL closed objects; the BR63 broadcom.o lacks them.
+ifeq ($(BUILD_NAME),TUF-AX3000_V2)
+OBJS += tuf_hw.o
+endif
+
 ifeq ($(and $(CONFIG_BCMWL5),$(RTCONFIG_DUALWAN)),y)
 ifneq ($(HND_ROUTER),y)
 OBJS += dualwan.o
@@ -2120,6 +2126,11 @@ endif
 endif
 endif
 
+ifeq ($(BUILD_NAME),TUF-AX3000_V2)
+tuf_hw.o:
+	@-cp -f ./prebuild/tuf_hw.o .
+endif
+
 ifeq ($(RTCONFIG_LACP),y)
 ifneq ($(wildcard ./prebuild/agg_brcm.o),)
 agg_brcm.o:
diff --git a/release/src/router/rc/prebuild/tuf_hw.o b/release/src/router/rc/prebuild/tuf_hw.o
new file mode 100644
index 0000000000000000000000000000000000000000..552f67d5d94a04ecc4732259c4d3c4fd15cf6201
GIT binary patch
