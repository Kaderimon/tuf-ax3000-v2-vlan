diff --git a/release/src/router/shared/sysdeps/broadcom/tuf_phy.c b/release/src/router/shared/sysdeps/broadcom/tuf_phy.c
new file mode 100644
index 000000000..bed070255
--- /dev/null
+++ b/release/src/router/shared/sysdeps/broadcom/tuf_phy.c
@@ -0,0 +1,82 @@
+/*
+ * TUF-AX3000_V2 port status helpers.
+ *
+ * The BR63 prebuilt private.o implements hnd_get_phy_*() as direct jumps to
+ * the Realtek rtk_get_phy_*() functions, with an int port argument. On the
+ * TUF every front port is a netdev and callers (wanduck, ethmon, watchdog,
+ * GetPhyStatus) pass the ifname, so read the link state from sysfs like the
+ * TUF's own 388 firmware does. The BR63 definitions are weakened in
+ * prebuild/private.o so that these take precedence.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <bcmnvram.h>
+#include <shutils.h>
+#include <net/if.h>
+#include "shared.h"
+
+/*
+ * Guard against callers compiled with the int-port prototype: map a small
+ * value to the ifname of the port with that phy_port_id instead of
+ * dereferencing it.
+ */
+static const char *port_ifname(const char *ifname)
+{
+	phy_port_mapping port_mapping;
+	static char buf[IFNAMSIZ];
+	int i;
+
+	if ((uintptr_t)ifname >= 4096)
+		return ifname;
+
+	get_phy_port_mapping(&port_mapping);
+	for (i = 0; i < port_mapping.count; i++) {
+		if (port_mapping.port[i].phy_port_id == (int)(uintptr_t)ifname && port_mapping.port[i].ifname) {
+			snprintf(buf, sizeof(buf), "%s", port_mapping.port[i].ifname);
+			return buf;
+		}
+	}
+	return NULL;
+}
+
+static int read_sys(const char *ifname, const char *attr, char *buf, int len)
+{
+	char path[128];
+
+	if (!(ifname = port_ifname(ifname)))
+		return 0;
+	snprintf(path, sizeof(path), "/sys/class/net/%s/%s", ifname, attr);
+	return f_read_string(path, buf, len) > 0;
+}
+
+uint32_t hnd_get_phy_status(char *ifname)
+{
+	char buf[16];
+
+	return read_sys(ifname, "operstate", buf, sizeof(buf)) && !strncmp(buf, "up", 2);
+}
+
+uint32_t hnd_get_phy_speed(char *ifname)
+{
+	char buf[16];
+
+	return read_sys(ifname, "speed", buf, sizeof(buf)) ? strtoul(buf, NULL, 10) : 0;
+}
+
+uint32_t hnd_get_phy_duplex(char *ifname)
+{
+	char buf[16];
+
+	return read_sys(ifname, "duplex", buf, sizeof(buf)) && !strncmp(buf, "full", 4);
+}
+
+uint64_t hnd_get_phy_mib(char *ifname, char *type)
+{
+	char attr[64], buf[32];
+
+	snprintf(attr, sizeof(attr), "statistics/%s", type);
+	return read_sys(ifname, attr, buf, sizeof(buf)) ? strtoull(buf, NULL, 10) : 0;
+}
