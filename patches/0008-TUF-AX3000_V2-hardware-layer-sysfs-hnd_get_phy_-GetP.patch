diff --git a/release/src/router/rc/tuf_vlan.c b/release/src/router/rc/tuf_vlan.c
new file mode 100644
index 000000000..2f504dc92
--- /dev/null
+++ b/release/src/router/rc/tuf_vlan.c
@@ -0,0 +1,123 @@
+/*
+ * TUF-AX3000_V2 replacements for hardware functions that the BR63 prebuilt
+ * broadcom.o implements on top of a Realtek RTL8367S switch (rtkswitch).
+ *
+ * On the TUF every front port is its own netdev (W0=eth0, L1..L4=eth1..eth4,
+ * see get_phy_port_mapping()). The generic APG/SDN code (amas_apg.o) already
+ * builds the VLANs in Linux: access ports are added to the VLAN bridge,
+ * trunk ports get 802.1Q sub-interfaces (apg_create_eth_vlan). The switch
+ * layer therefore only has to make sure the BCM switch does not forward
+ * between front ports on its own, bypassing the Linux bridges.
+ *
+ * The BR63 definitions of these symbols are weakened in
+ * prebuild/broadcom.o so that these take precedence.
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include "rc.h"
+#include "shared.h"
+
+/* Same letters as the other platforms' port status strings. */
+static char conv_speed(int link, unsigned int speed)
+{
+	if (!link)
+		return 'X';
+	switch (speed) {
+	case 10000: return 'T';
+	case 5000:  return 'F';
+	case 2500:  return 'Q';
+	case 1000:  return 'G';
+	default:    return 'M';
+	}
+}
+
+int GetPhyStatus(int verbose, phy_info_list *list)
+{
+	phy_port_mapping port_mapping;
+	char cap_buf[64], out[256] = "";
+	int i, n, link, ret = 0;
+	unsigned int speed;
+
+	get_phy_port_mapping(&port_mapping);
+	if (list)
+		list->count = 0;
+
+	for (i = 0; i < port_mapping.count; i++) {
+		phy_port *p = &port_mapping.port[i];
+
+		/* Only Ethernet WAN/LAN ports have a netdev; USB etc. are reported elsewhere. */
+		if (!p->ifname || !(p->cap & (PHY_PORT_CAP_WAN | PHY_PORT_CAP_LAN)))
+			continue;
+
+		link = hnd_get_phy_status(p->ifname) ? 1 : 0;
+		speed = link ? hnd_get_phy_speed(p->ifname) : 0;
+		if (link && p->phy_port_id >= 0)
+			ret |= 1 << p->phy_port_id;
+
+		n = strlen(out);
+		snprintf(out + n, sizeof(out) - n, "%s=%c;", p->label_name, conv_speed(link, speed));
+
+		if (list && list->count < MAX_PHY_PORT) {
+			phy_info *pi = &list->phy_info[list->count++];
+
+			memset(pi, 0, sizeof(*pi));
+			pi->phy_port_id = p->phy_port_id;
+			snprintf(pi->label_name, sizeof(pi->label_name), "%s", p->label_name);
+			pi->cap = p->cap;
+			snprintf(pi->cap_name, sizeof(pi->cap_name), "%s",
+				get_phy_port_cap_name(p->cap, cap_buf, sizeof(cap_buf)));
+			snprintf(pi->state, sizeof(pi->state), "%s", link ? "up" : "down");
+			pi->link_rate = speed;
+			snprintf(pi->duplex, sizeof(pi->duplex), "%s",
+				!link ? "none" : hnd_get_phy_duplex(p->ifname) ? "full" : "half");
+			pi->tx_bytes = hnd_get_phy_mib(p->ifname, "tx_bytes");
+			pi->rx_bytes = hnd_get_phy_mib(p->ifname, "rx_bytes");
+			pi->tx_packets = hnd_get_phy_mib(p->ifname, "tx_packets");
+			pi->rx_packets = hnd_get_phy_mib(p->ifname, "rx_packets");
+			pi->crc_errors = hnd_get_phy_mib(p->ifname, "rx_crc_errors");
+			pi->flag = p->flag;
+		}
+	}
+
+	if (verbose)
+		puts(out);
+
+	return ret;
+}
+
+/*
+ * Front ports take part in VLANs through Linux bridges and 802.1Q
+ * sub-interfaces, which only works if the switch hands every frame to the
+ * CPU. Turn hardware switching off the first time any VLAN or isolation is
+ * configured; it stays off until reboot.
+ */
+static void tuf_switch_via_cpu(const char *why)
+{
+	static int done;
+
+	if (done)
+		return;
+	done = 1;
+	_dprintf("%s: disabling switch hw-switching (%s)\n", __func__, why);
+	eval("ethswctl", "-c", "hw-switching", "-o", "disable");
+}
+
+void apg_switch_vlan_set(int vid, unsigned int default_portmask, unsigned int trunk_portmask, unsigned int access_portmask)
+{
+	_dprintf("%s: vid=%d default=0x%x trunk=0x%x access=0x%x\n", __func__,
+		vid, default_portmask, trunk_portmask, access_portmask);
+	tuf_switch_via_cpu("vlan set");
+}
+
+void apg_switch_vlan_unset(int vid, unsigned int portmask)
+{
+	_dprintf("%s: vid=%d portmask=0x%x\n", __func__, vid, portmask);
+}
+
+void apg_switch_isolation(int enable, unsigned int portmask)
+{
+	_dprintf("%s: enable=%d portmask=0x%x\n", __func__, enable, portmask);
+	if (enable)
+		tuf_switch_via_cpu("isolation");
+}
